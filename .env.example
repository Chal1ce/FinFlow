# Copy this file to .env and fill in the values that apply to your machine.
#   cp .env.example .env
# .env is ignored by git and should never be committed.

# Data lake root and derived-artifact locations.
# The path defaults shown here are also used when the variable is commented out.
FIN_DOC_DATA_ROOT=data
# FIN_DOC_RAW_PDFS=data/raw_pdfs
# FIN_DOC_PARSED_MD=data/parsed_md
# FIN_DOC_PROCESSED=data/processed
# FIN_DOC_GOVERNED=data/processed/governed
# FIN_DOC_CHUNKS_DIR=data/processed/chunks
# FIN_DOC_CHUNKS_JSONL=data/processed/chunks.jsonl
# FIN_DOC_MANIFESTS=data/manifests
# FIN_DOC_STATE_DB=data/state/pipeline.db

# Runtime logs. Each CLI writes to this rotating local file as well as stderr.
# FIN_DOC_LOG_LEVEL=INFO
# FIN_DOC_LOG_FORMAT=pretty
# FIN_DOC_LOG_COLOR=auto
# FIN_DOC_LOG_FILE=logs/fin-doc-governance.log
# FIN_DOC_LOG_MAX_BYTES=5242880
# FIN_DOC_LOG_BACKUP_COUNT=5

# Shared HTTP identity used by spiders and OCR clients.
FIN_DOC_USER_AGENT=fin-doc-governance/0.1

# Self-hosted PaddleX/PP-StructureV3 Basic Serving.
# Leave PADDLEOCR_LOCAL_TOKEN empty when the local service does not require one.
PADDLEOCR_LOCAL_API_URL=http://127.0.0.1:18080/layout-parsing
PADDLEOCR_LOCAL_TOKEN=
PADDLEOCR_LOCAL_TIMEOUT_SECONDS=900
# Maximum PDF pages per Paddle Serving request.  This is not a document limit.
PADDLEOCR_LOCAL_PAGE_BATCH_SIZE=20
PADDLEOCR_LOCAL_OPTIONS={"useDocOrientationClassify":true,"useDocUnwarping":true,"useTextlineOrientation":true,"useTableRecognition":true,"useFormulaRecognition":true,"useChartRecognition":true}

# Official PaddleOCR cloud API.
# PADDLEOCR_CLOUD_TOKEN is required for --ocr-backend cloud.
PADDLEOCR_CLOUD_TOKEN=
PADDLEOCR_CLOUD_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_CLOUD_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_CLOUD_POLL_INTERVAL_SECONDS=5
PADDLEOCR_CLOUD_TIMEOUT_SECONDS=1800
# Cloud job queue is retried with exponential backoff when it is full.
PADDLEOCR_CLOUD_SUBMIT_RETRY_ATTEMPTS=3
PADDLEOCR_CLOUD_SUBMIT_RETRY_BACKOFF_SECONDS=10
PADDLEOCR_CLOUD_OPTIONAL_PAYLOAD={"useDocOrientationClassify":false,"useDocUnwarping":false,"useChartRecognition":false}

# Deterministic cleaning and chunking rules.
# FIN_DOC_RULE_VERSION=ocr-cleaning-v3
# FIN_DOC_DROP_BLOCK_LABELS=["header","footer","number","image","chart","vision_footnote"]
# FIN_DOC_CHUNK_MAX_CHARS=2000
# FIN_DOC_CHUNK_MIN_CHARS=80

# Standalone LLM governance layer. backend=auto uses the OpenAI Python SDK when a key is
# present and falls back to a deterministic mock otherwise. LLM_API_URL is an
# optional SDK base_url; omit it for the official OpenAI default or set it for
# an OpenAI-compatible service.
LLM_BACKEND=auto
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=2

# Launcher override: export PYTHON_BIN in the invoking shell when needed.
# The launcher selects Python before loading .env; this file is never sourced.
# PYTHON_BIN=python3

# Legacy aliases, read only when the PADDLEOCR_LOCAL_* values above are unset.
# PADDLEOCR_API_URL=http://127.0.0.1:18080/layout-parsing
# PADDLEOCR_TOKEN=

# Daily flywheel. Credentials are loaded by Python, never sourced by run_flywheel.sh.
FIN_DOC_FLYWHEEL_OCR_BACKEND=local
# Optional override of config/flywheel.json OCR options; default preserves original page coordinates.
# FIN_DOC_FLYWHEEL_OCR_OPTIONS={"useDocOrientationClassify":false,"useDocUnwarping":false,"useTableRecognition":true}
FIN_DOC_FLYWHEEL_MAX_TASKS=100
FIN_DOC_FLYWHEEL_MAX_MODEL_REQUESTS=50
FIN_DOC_FLYWHEEL_MAX_SECONDS=7200
# Local Hugging Face tokenizer.json matching the model you intend to pretrain.
# FIN_DOC_PRETRAIN_TOKENIZER=/absolute/path/to/tokenizer.json
FIN_DOC_PRETRAIN_MAX_TOKENS=2048
# Optional OpenAlex key sent as an Authorization header; anonymous queries remain supported.
# OPENALEX_API_KEY=

# Independent vision and evidence-review roles; both required by the default recipe.
# Endpoints are OpenAI-compatible base URLs (such as https://provider.example/v1).
# FIN_DOC_VISION_API_URL=
# FIN_DOC_VISION_API_KEY=
# FIN_DOC_VISION_MODEL=
# FIN_DOC_VISION_MODEL_VERSION=
FIN_DOC_VISION_TIMEOUT=120
FIN_DOC_VISION_MAX_TOKENS=4096
# FIN_DOC_PRETRAIN_REVIEW_API_URL=
# FIN_DOC_PRETRAIN_REVIEW_API_KEY=
# FIN_DOC_PRETRAIN_REVIEW_MODEL=
# FIN_DOC_PRETRAIN_REVIEW_MODEL_VERSION=
FIN_DOC_PRETRAIN_REVIEW_TIMEOUT=120
FIN_DOC_PRETRAIN_REVIEW_MAX_TOKENS=4096

# Optional transformations: add translate/rewrite to methods in config/flywheel.json.
# FIN_DOC_PRETRAIN_TRANSLATE_API_URL=
# FIN_DOC_PRETRAIN_TRANSLATE_API_KEY=
# FIN_DOC_PRETRAIN_TRANSLATE_MODEL=
# FIN_DOC_PRETRAIN_TRANSLATE_MODEL_VERSION=
FIN_DOC_PRETRAIN_TRANSLATE_TIMEOUT=120
FIN_DOC_PRETRAIN_TRANSLATE_MAX_TOKENS=4096
# FIN_DOC_PRETRAIN_REWRITE_API_URL=
# FIN_DOC_PRETRAIN_REWRITE_API_KEY=
# FIN_DOC_PRETRAIN_REWRITE_MODEL=
# FIN_DOC_PRETRAIN_REWRITE_MODEL_VERSION=
FIN_DOC_PRETRAIN_REWRITE_TIMEOUT=120
FIN_DOC_PRETRAIN_REWRITE_MAX_TOKENS=4096

# Optional distill/textbook/knowledge_list/diverse_qa transformations use this shared role.
# Enable the selected methods in your flywheel.local.json; original and review remain separate.
# FIN_DOC_PRETRAIN_SYNTHESIZE_API_URL=
# FIN_DOC_PRETRAIN_SYNTHESIZE_API_KEY=
# FIN_DOC_PRETRAIN_SYNTHESIZE_MODEL=
# FIN_DOC_PRETRAIN_SYNTHESIZE_MODEL_VERSION=
FIN_DOC_PRETRAIN_SYNTHESIZE_TIMEOUT=120
FIN_DOC_PRETRAIN_SYNTHESIZE_MAX_TOKENS=4096

# Existing LLM_* governs text metadata when governance_backend=auto and a key exists.
# LLM_MODEL_VERSION=
# LLM_MAX_TOKENS=4096

# Optional Feishu channel. Copy config/integrations.json to config/integrations.local.json
# for user roles and chats; see docs/app-integrations.md. MCP queries need no Feishu credentials.
# FINFLOW_FEISHU_APP_ID=
# FINFLOW_FEISHU_APP_SECRET=

# Optional Telegram / Discord / Slack entries; configure IDs and roles in
# config/integrations.local.json. All native channels are disabled by default.
# FINFLOW_TELEGRAM_BOT_TOKEN=
# FINFLOW_DISCORD_BOT_TOKEN=
# FINFLOW_SLACK_BOT_TOKEN=
# FINFLOW_SLACK_APP_TOKEN=

# Optional evidence-grounded SFT. Disabled in the daily flywheel by default.
# A separate local CLI can consume an existing v7 release without OCR or a CPT tokenizer.
# Table-calculation review requires an image-capable review model.
# FIN_DOC_SFT_GENERATE_API_URL=
# FIN_DOC_SFT_GENERATE_API_KEY=
# FIN_DOC_SFT_GENERATE_MODEL=
# FIN_DOC_SFT_GENERATE_MODEL_VERSION=
FIN_DOC_SFT_GENERATE_TIMEOUT=120
FIN_DOC_SFT_GENERATE_MAX_TOKENS=4096
# FIN_DOC_SFT_REVIEW_API_URL=
# FIN_DOC_SFT_REVIEW_API_KEY=
# FIN_DOC_SFT_REVIEW_MODEL=
# FIN_DOC_SFT_REVIEW_MODEL_VERSION=
FIN_DOC_SFT_REVIEW_TIMEOUT=120
FIN_DOC_SFT_REVIEW_MAX_TOKENS=4096

# Optional CodecLM contrastive filtering: actual target model to diagnose, not another teacher alias.
# Required only when contrastive_filter=true in an SFT recipe using codeclm.
# FIN_DOC_SFT_TARGET_API_URL=
# FIN_DOC_SFT_TARGET_API_KEY=
# FIN_DOC_SFT_TARGET_MODEL=
# FIN_DOC_SFT_TARGET_MODEL_VERSION=
FIN_DOC_SFT_TARGET_TIMEOUT=120
FIN_DOC_SFT_TARGET_MAX_TOKENS=4096

# Optional multimodal SFT tasks: visual_qa and table_structure.
# Both roles must accept image inputs. See config/sft-vision.json and docs/sft-vision.md.
# FIN_DOC_SFT_VISION_GENERATE_API_URL=
# FIN_DOC_SFT_VISION_GENERATE_API_KEY=
# FIN_DOC_SFT_VISION_GENERATE_MODEL=
# FIN_DOC_SFT_VISION_GENERATE_MODEL_VERSION=
FIN_DOC_SFT_VISION_GENERATE_TIMEOUT=120
FIN_DOC_SFT_VISION_GENERATE_MAX_TOKENS=4096
# FIN_DOC_SFT_VISION_REVIEW_API_URL=
# FIN_DOC_SFT_VISION_REVIEW_API_KEY=
# FIN_DOC_SFT_VISION_REVIEW_MODEL=
# FIN_DOC_SFT_VISION_REVIEW_MODEL_VERSION=
FIN_DOC_SFT_VISION_REVIEW_TIMEOUT=120
FIN_DOC_SFT_VISION_REVIEW_MAX_TOKENS=4096
