{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finflow:agentic:case:0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "research",
        "operations"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "split": {
      "enum": [
        "design_demo",
        "train",
        "validation",
        "test"
      ]
    },
    "grouping": {
      "type": "object",
      "properties": {
        "source_group": {
          "type": "string",
          "minLength": 1
        },
        "base_snapshot_group": {
          "type": "string",
          "minLength": 1
        },
        "template_family": {
          "type": "string",
          "minLength": 1
        },
        "variant_family": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_group",
        "base_snapshot_group",
        "template_family",
        "variant_family"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "reward": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "environment",
        "reward",
        "fingerprint",
        "dataset"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "task": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "fixture": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "oracle": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "tool_registry": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "task",
        "fixture",
        "oracle",
        "tool_registry"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "task_id",
    "track",
    "synthetic",
    "split",
    "grouping",
    "versions",
    "files"
  ],
  "additionalProperties": false
}
