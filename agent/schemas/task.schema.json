{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finflow:agentic:task:0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "research",
        "operations"
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "time_cutoff": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope_id"
      ],
      "additionalProperties": false
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "enum": [
          "search_documents",
          "read_table",
          "calculate",
          "submit_answer",
          "inspect_state",
          "inspect_task",
          "trace_lineage",
          "verify_artifacts",
          "inspect_policy",
          "list_recovery_sources",
          "retry_task",
          "run_pending",
          "restore_artifact",
          "record_escalation",
          "submit_resolution"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens_per_turn": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_actions",
        "max_context_tokens",
        "max_output_tokens_per_turn",
        "max_total_output_tokens"
      ],
      "additionalProperties": false
    },
    "output_contract": {
      "enum": [
        "research-answer-v0.1",
        "operations-resolution-v0.1"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "track",
    "instruction",
    "context",
    "allowed_tools",
    "budgets",
    "output_contract"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "track": {
            "const": "research"
          }
        }
      },
      "then": {
        "properties": {
          "allowed_tools": {
            "type": "array",
            "items": {
              "enum": [
                "search_documents",
                "read_table",
                "calculate",
                "submit_answer"
              ]
            },
            "minItems": 1
          },
          "output_contract": {
            "const": "research-answer-v0.1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "operations"
          }
        }
      },
      "then": {
        "properties": {
          "allowed_tools": {
            "type": "array",
            "items": {
              "enum": [
                "inspect_state",
                "inspect_task",
                "trace_lineage",
                "verify_artifacts",
                "inspect_policy",
                "list_recovery_sources",
                "retry_task",
                "run_pending",
                "restore_artifact",
                "record_escalation",
                "submit_resolution"
              ]
            },
            "minItems": 1
          },
          "output_contract": {
            "const": "operations-resolution-v0.1"
          }
        }
      }
    }
  ]
}
