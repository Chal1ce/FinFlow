{
  "schema_version": "finflow-mixture-experiment-v1",
  "inputs": ["data/training/snapshots/cpt-all"],
  "group_fields": ["source_name"],
  "tokenizer": "models/tokenizer.json",
  "eos_token_id": null,
  "sequence_length": 256,
  "max_prepared_tokens": 10000000,
  "proxy": {
    "device": "cpu",
    "width": 128,
    "heads": 4,
    "layers": 2,
    "steps": 500,
    "reference_steps": 500,
    "batch_size": 4,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "checkpoint_every": 50,
    "eval_blocks_per_domain": 64,
    "seed": 42,
    "threads": 4,
    "doremi_eta": 1.0,
    "doremi_smoothing": 0.001
  },
  "regmix": {
    "trials": 32,
    "search_candidates": 4096,
    "estimators": 200,
    "num_leaves": 7,
    "learning_rate": 0.05
  }
}
